{
  "name": "orbit",
  "version": "0.3.0",
  "description": "Open-source, provider-agnostic desktop assistant for Windows",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:runners": "esbuild scripts/runner-parity.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=out/test/runner-parity.cjs --log-level=warning && electron out/test/runner-parity.cjs",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.69",
    "@ai-sdk/openai-compatible": "3.0.60",
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@mozilla/readability": "0.6.0",
    "ai": "7.0.123",
    "croner": "10.0.1",
    "koffi": "3.3.2",
    "linkedom": "0.18.13",
    "lucide-react": "1.49.0",
    "marked": "18.0.14",
    "quickjs-emscripten-core": "0.32.0",
    "selection-hook": "2.1.1",
    "sherpa-onnx-node": "1.13.8",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.12.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "author": "ChasingHunter",
  "build": {
    "appId": "dev.orbit.desktop",
    "productName": "Orbit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-win-x64/**",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**",
      "**/node_modules/selection-hook/**",
      "**/node_modules/@jitl/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false
    }
  }
}
